{
  "tree_diagram": "diagrams/uc-tree.svg",
  "outcomes": [
    {
      "id": "O1",
      "text": "Anyone opens one page and sees every project's latest status within 10 seconds of a change.",
      "ucs": [
        "UC-01",
        "UC-02"
      ]
    }
  ],
  "ucs": [
    {
      "id": "UC-01",
      "tier": "Main",
      "title": "View project status",
      "source": "mixed",
      "entities": [
        "Status update"
      ],
      "summary": "A team member opens the status page and sees every project's latest status and how fresh it is.",
      "components": [
        "CMP-WEB",
        "CMP-API",
        "CMP-API-READ",
        "CMP-DB"
      ],
      "flows": [
        {
          "id": "good",
          "kind": "good",
          "title": "Status page loads",
          "touchpoints": [
            {
              "step": "6",
              "sees": "Project cards with \"Updated 3s ago\""
            }
          ]
        },
        {
          "id": "bad-timeout",
          "kind": "bad",
          "title": "API timeout",
          "touchpoints": [
            {
              "step": "2c",
              "sees": "\"Couldn't load status. Retry\""
            }
          ]
        },
        {
          "id": "bad-db",
          "kind": "bad",
          "title": "Database error",
          "touchpoints": [
            {
              "step": "3d",
              "sees": "\"Something went wrong. Try again later\""
            }
          ]
        },
        {
          "id": "edge-empty",
          "kind": "edge",
          "title": "Zero projects",
          "touchpoints": [
            {
              "step": "4f",
              "sees": "\"No projects yet. Create one\""
            }
          ]
        },
        {
          "id": "edge-many",
          "kind": "edge",
          "title": "500+ projects",
          "touchpoints": [
            {
              "step": "4i",
              "sees": "First 50 projects with a \"Load more\" button"
            }
          ]
        }
      ],
      "details": [
        {
          "title": "Step 2: GET /projects (components inside the API)",
          "diagram": "diagrams/uc-01-detail.svg"
        }
      ],
      "diagram": "diagrams/uc-01.svg",
      "step_changes": {
        "2": "changed",
        "4g": "added"
      },
      "steps": [
        {
          "id": "1",
          "label": "[CALL] Open status page",
          "from": "CMP-WEB",
          "to": "CMP-WEB",
          "call": "web/src/api/projects.ts:2"
        },
        {
          "id": "2",
          "label": "[REST] Fetch project list",
          "from": "CMP-WEB",
          "to": "CMP-API",
          "call": "web/src/api/projects.ts:3"
        },
        {
          "id": "2.1",
          "label": "[CALL] Hand over to read handler",
          "from": "CMP-API",
          "to": "CMP-API-READ",
          "call": "api/src/read_handler.py:2"
        },
        {
          "id": "3",
          "label": "[SQL] Read latest status",
          "from": "CMP-API-READ",
          "to": "CMP-DB",
          "call": "api/src/read_handler.py:3"
        },
        {
          "id": "4",
          "label": "[SQL] Return rows",
          "from": "CMP-DB",
          "to": "CMP-API-READ",
          "call": "api/src/read_handler.py:4"
        },
        {
          "id": "5",
          "label": "[REST] Return project list",
          "from": "CMP-API",
          "to": "CMP-WEB",
          "call": "web/src/api/projects.ts:5"
        }
      ]
    },
    {
      "id": "UC-02",
      "tier": "Main",
      "title": "Update a project's status",
      "source": "draft",
      "summary": "A project lead changes a status and everyone watching sees the new value in seconds.",
      "components": [
        "CMP-WEB",
        "CMP-API",
        "CMP-QUEUE",
        "CMP-AGG",
        "CMP-DB"
      ],
      "flows": [
        {
          "id": "good",
          "kind": "good",
          "title": "Update is published",
          "touchpoints": [
            {
              "step": "3",
              "sees": "\"Status saved\""
            }
          ]
        },
        {
          "id": "bad-invalid",
          "kind": "bad",
          "title": "Invalid status",
          "touchpoints": [
            {
              "step": "1b",
              "sees": "\"That status isn't allowed. Pick another\""
            }
          ]
        },
        {
          "id": "bad-queue",
          "kind": "bad",
          "title": "Queue unavailable",
          "touchpoints": [
            {
              "step": "3b",
              "sees": "\"Saved, but others may see it late\""
            }
          ]
        },
        {
          "id": "edge-duplicate",
          "kind": "edge",
          "title": "Same status twice",
          "touchpoints": [
            {
              "step": "4e",
              "sees": "No change and no duplicate history row"
            }
          ]
        },
        {
          "id": "edge-concurrent",
          "kind": "edge",
          "title": "Two updates at once",
          "touchpoints": [
            {
              "step": "4g",
              "sees": "The latest update wins; the older one stays in history"
            }
          ]
        }
      ],
      "diagram": "diagrams/uc-02.svg",
      "step_changes": {
        "1": "changed",
        "2": "added",
        "4": "added",
        "5": "changed",
        "2b": "added",
        "3b": "added",
        "4e": "added",
        "4f": "changed"
      },
      "steps": [
        {
          "id": "1",
          "label": "[REST] Submit new status",
          "from": "CMP-WEB",
          "to": "CMP-API"
        },
        {
          "id": "2",
          "label": "[MQ] Publish status event",
          "from": "CMP-API",
          "to": "CMP-QUEUE"
        },
        {
          "id": "4",
          "label": "[MQ] Deliver status event",
          "from": "CMP-QUEUE",
          "to": "CMP-AGG"
        },
        {
          "id": "5",
          "label": "[SQL] Save status and history",
          "from": "CMP-AGG",
          "to": "CMP-DB"
        }
      ]
    },
    {
      "id": "UC-03",
      "tier": "Affected",
      "title": "Weekly report",
      "source": "code",
      "caused_by": "CMP-DB",
      "entities": [
        "Weekly report"
      ],
      "summary": "Managers still receive a weekly summary, now built from status history instead of the spreadsheet.",
      "components": [
        "CMP-CRON",
        "CMP-AGG",
        "CMP-DB"
      ],
      "flows": [
        {
          "id": "good",
          "kind": "good",
          "title": "Report is emailed",
          "touchpoints": [
            {
              "step": "4",
              "sees": "Weekly email with every project's status"
            }
          ]
        },
        {
          "id": "edge-first",
          "kind": "edge",
          "title": "First week",
          "touchpoints": [
            {
              "step": "1e",
              "sees": "Report lists every project as new"
            }
          ]
        },
        {
          "id": "edge-quiet",
          "kind": "edge",
