          "touchpoints": [
            {
              "step": "3e",
              "sees": "Email says nothing changed"
            }
          ]
        },
        {
          "id": "bad-email",
          "kind": "bad",
          "title": "Email send fails",
          "touchpoints": [
            {
              "step": "4b",
              "sees": "Report arrives late, after the retry"
            }
          ]
        }
      ],
      "diagram": "diagrams/uc-03.svg",
      "step_changes": {
        "1": "added",
        "2": "changed",
        "4": "added",
        "3e": "added"
      },
      "steps": [
        {
          "id": "1",
          "label": "[CALL] Start weekly export",
          "from": "CMP-CRON",
          "to": "CMP-CRON",
          "call": "jobs/weekly_export.py:2"
        },
        {
          "id": "2",
          "label": "[SQL] Read week history",
          "from": "CMP-CRON",
          "to": "CMP-DB",
          "call": "jobs/weekly_export.py:3"
        },
        {
          "id": "4",
          "label": "[CALL] Send weekly email",
          "from": "CMP-CRON",
          "to": "CMP-CRON",
          "call": "jobs/weekly_export.py:4"
        }
      ]
    }
  ],
