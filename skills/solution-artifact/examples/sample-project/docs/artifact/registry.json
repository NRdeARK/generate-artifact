      "kind": "system",
      "c4_level": "L1",
      "status": "changed",
      "change": {
        "what": "The system now takes status updates as events, shows them on one page and keeps the weekly email.",
        "why": "Together these changes give everyone fresh status while managers still get their weekly summary.",
        "ucs": [
          "UC-01",
          "UC-02",
          "UC-03"
        ],
        "decisions": [
          "D1"
        ],
        "waive": {
          "files": "System-level view; the file changes are listed on its containers."
        },
